/* Light scheme (Default) */
/* Can be forced with data-theme="light" */
[data-theme="light"],
:root:not([data-theme="dark"]) {
  --primary:hsl(81, 62.00%, 36.10%);
  --primary-hover:hsl(81, 63.90%, 45.70%);
  --primary-dark:hsl(81, 41.80%, 32.40%);
  --primary-focus:hsla(81, 41.20%, 62.00%, 0.25);
  --primary-inverse: #fff;
  --primary-rgb: 109, 149, 35;
  --primary-dark-rgb: 93, 117, 48;
  
  --selection: #c3c92c80;
  
  --secondary: hsl(20, 100.00%, 25.10%);
  --secondary-hover: hsl(20, 85.40%, 34.90%);
  --secondary-focus:hsla(22, 41.20%, 48.00%, 0.25);
  --secondary-inverse: #fff;
  --secondary-rgb: 128, 43, 0;
  
  --contrast: #4c48ad;
  --contrast-hover: #807ce6;
  --contrast-focus: #807ce640;
  --contrast-inverse: #fff;
  --contrast-rgb: 76, 72, 173;

  --tooltip-background-color: var(--secondary);
}

/* Dark scheme (Auto) */
/* Automatically enabled if user has Dark mode enabled */
/* @media only screen and (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --primary: #a9ad48;
    --primary-hover: #c3c92c;
    --primary-focus: rgba(195, 198, 118, 0.25);
    --primary-inverse: #FFF;
    
    --secondary: #ad6d48;
    --secondary-hover: #e36c27;
    --secondary-focus: rgba(173, 109, 72, 0.25);
    --secondary-inverse: #FFF;
  }
} */

@media only screen and (prefers-color-scheme: dark) {
  :root:not([data-theme=light]) { 
    --primary: #a9ad48;
    --primary-hover: #c3c92c;
    --primary-focus: rgba(195, 198, 118, 0.25);
    --primary-inverse: #fff;

    --selection: rgba(195, 201, 44, 0.5);
    
    --secondary: #ad6d48;
    --secondary-hover: #e36c27;
    --secondary-focus: rgba(173, 109, 72, 0.25);
    --secondary-inverse: #FFF;
  }
}

/* Pink Dark scheme (Forced) */
/* Enabled if forced with data-theme="dark" */
[data-theme="dark"] {
  --primary: #a9ad48;
  --primary-hover: #c3c92c;
  --primary-focus: rgba(195, 198, 118, 0.25);
  --primary-inverse: #FFF;
  --primary-rgb: 146, 150, 35;
  --selection: rgba(195, 201, 44, 0.5);
  
  
  --secondary: #ad6d48;
  --secondary-hover: #e36c27;
  --secondary-focus: rgba(173, 109, 72, 0.25);
  --secondary-inverse: #FFF;
}

/* (Common styles) */
:root {
  --form-element-active-border-color: var(--primary);
  --form-element-focus-color: var(--primary-focus);
  --switch-color: var(--primary-inverse);
  --switch-checked-background-color: var(--primary);
}